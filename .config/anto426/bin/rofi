#!/usr/bin/env bash
# =============================================================================
# ANTO426 ROFI MONOCHROME ICON WRAPPER
# Automatically maps colored system icons to premium Nerd Font icons
# =============================================================================
set -uo pipefail

REAL_ROFI="/usr/bin/rofi"

# 1. Parse arguments to check if it's a dmenu invocation and filter out -show-icons
has_dmenu=0
filtered_args=()
for arg in "$@"; do
    if [[ "$arg" == "-dmenu" ]]; then
        has_dmenu=1
        filtered_args+=("$arg")
    elif [[ "$arg" == "-show-icons" ]]; then
        # Skip -show-icons to ensure monochrome/no-system-icons look
        continue
    else
        filtered_args+=("$arg")
    fi
done

# If not dmenu, directly execute the real rofi
if [[ "$has_dmenu" -eq 0 ]]; then
    exec "$REAL_ROFI" "$@"
fi

# 2. Setup map files for tracking selection translation
MAP_FILE="$(mktemp)"
trap 'rm -f "$MAP_FILE" "$MAP_FILE.choice" 2>/dev/null' EXIT

# 3. Use AWK to process stdin: map system icons to Nerd Font and save the translation table
awk -v MAP_FILE="$MAP_FILE" '
BEGIN {
    FS = "\x00"
    
    # Detailed mappings from system icon names to Nerd Font icons
    map["network-wireless"] = "󰤨"
    map["network-wireless-signal-excellent"] = "󰤨"
    map["network-wireless-signal-excellent-secure"] = "󰤨"
    map["network-wireless-signal-good"] = "󰤨"
    map["network-wireless-signal-good-secure"] = "󰤨"
    map["network-wireless-signal-ok"] = "󰤨"
    map["network-wireless-signal-ok-secure"] = "󰤨"
    map["network-wireless-signal-weak"] = "󰤨"
    map["network-wireless-signal-weak-secure"] = "󰤨"
    map["network-wireless-connected"] = "󰤨"
    
    map["preferences-system-bluetooth"] = "󰂯"
    map["bluetooth"] = "󰂯"
    map["bluetooth-active"] = "󰂱"
    
    map["audio-volume-high"] = ""
    map["audio-volume-medium"] = ""
    map["audio-volume-low"] = ""
    map["audio-volume-muted"] = "󰝟"
    map["audio-card"] = "󰓃"
    map["emblem-default"] = "󰄬"
    
    map["display-brightness"] = "󰃠"
    
    map["battery"] = ""
    map["battery-good"] = ""
    map["battery-low"] = ""
    map["battery-full"] = ""
    
    map["input-keyboard"] = "󰌌"
    map["preferences-desktop-keyboard"] = "󰌌"
    
    map["preferences-desktop-notification"] = "󰂚"
    
    map["office-calendar"] = "󰃭"
    map["appointment-new"] = "󰃭"
    map["go-jump"] = "󰃭"
    
    map["video-display"] = "󰍹"
    map["preferences-desktop-wallpaper"] = "󰸉"
    map["preferences-desktop-theme"] = "󰘦"
    map["window-restore"] = "󰖲"
    map["system-shutdown"] = ""
    map["system-suspend"] = "󰤄"
    map["system-reboot"] = "󰜉"
    map["system-log-out"] = "󰈆"
    map["system-lock-screen"] = "󰌾"
    
    map["microphone-sensitivity-muted"] = "󰍭"
    map["microphone-sensitivity-high"] = "󰍬"
    map["audio-input-microphone"] = "󰍬"
    map["multimedia-volume-control"] = "󰒓"
    
    map["dialog-information"] = "󰙔"
    map["info"] = "󰙔"
    map["utilities-system-monitor"] = "󰙔"
    
    map["go-previous"] = "󰌍"
    map["go-home"] = "󰋜"
    
    map["view-refresh"] = "󰑖"
    map["security-high"] = "󰌿"
    map["edit-copy"] = "󰆏"
    map["user-trash"] = "󰩹"
    map["system-search"] = "󰑖"
    map["preferences-system"] = "󰒓"
    
    map["list-add"] = "󰐕"
    map["list-remove"] = "󰍴"
    map["web-browser"] = "󰖟"
    map["media-playlist-next"] = "󰼛"
    map["media-playlist-previous"] = "󰼚"
    map["application-x-executable"] = "󰘦"
    map["view-grid-symbolic"] = "󰘦"
    map["dialog-error"] = "󰅚"
    map["window-close"] = "󰅙"
    map["process-stop"] = "󰅚"
}
{
    display_part = $1
    meta_part = $2
    
    icon_name = ""
    if (meta_part ~ /icon/) {
        # Parse icon name out of metadata part
        # meta_part can be: icon\x1fnetwork-wireless or icon\tnetwork-wireless
        # We split by control codes and spaces
        n_parts = split(meta_part, parts, /[\x00-\x1f\t ]+/)
        for (i = 1; i <= n_parts; i++) {
            if (parts[i] == "icon" && i < n_parts) {
                icon_name = parts[i+1]
                break
            }
        }
        # Fallback regex if splitting did not isolate it
        if (icon_name == "") {
            match(meta_part, /icon[^\x00-\x1f\t ]+([^\x00-\x1f\t ]+)/, m)
            if (m[1] != "") icon_name = m[1]
        }
    }
    
    nf_char = ""
    if (icon_name != "") {
        nf_char = map[icon_name]
        if (nf_char == "") {
            # Try matching prefixes (e.g. bluetooth-active -> bluetooth)
            for (k in map) {
                if (index(icon_name, k) == 1) {
                    nf_char = map[k]
                    break
                }
            }
        }
        if (nf_char == "") {
            nf_char = "󰘦"  # default icon
        }
    }
    
    # Build display text
    new_display = display_part
    if (nf_char != "") {
        # Check if already has a Nerd Font icon prepended
        # Nerd Font characters are in high Unicode blocks
        new_display = nf_char "  " display_part
    }
    
    # Print the line to feed to rofi (with system icon stripped)
    print new_display
    
    # Save the mapping back to map file
    print new_display "\t" display_part >> MAP_FILE
}
' | "$REAL_ROFI" "${filtered_args[@]}" > "$MAP_FILE.choice" || exit_code=$?

# If rofi was cancelled or empty choice
if [[ ! -s "$MAP_FILE.choice" ]]; then
    exit ${exit_code:-0}
fi

choice="$(cat "$MAP_FILE.choice")"
rm -f "$MAP_FILE.choice"

# Look up the original choice in our mapping file
original_choice=""
if [[ -f "$MAP_FILE" ]]; then
    original_choice="$(awk -F'\t' -v choice="$choice" '$1 == choice {print $2; exit}' "$MAP_FILE")"
fi

# Print either the mapped original choice or the choice itself
printf '%s\n' "${original_choice:-$choice}"

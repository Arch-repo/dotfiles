{
    "label": "lock",
    "action": "hyprlock",
    "text": "Lock (L)",
    "keybind": "l"
}
{
    "label": "logout",
    "action": "hyprctl dispatch exit 0",
    "text": "Logout (E)",
    "keybind": "e"
}
{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "Sleep (S)",
    "keybind": "s"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Restart (R)",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Power (P)",
    "keybind": "p"
}
{
    "label": "cancel",
    "action": "pkill -x wlogout",
    "text": "Cancel (C)",
    "keybind": "c"
}

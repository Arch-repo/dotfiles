* {
    background: #3e2d28;
    surface: #7f635d;
    background-alpha: rgba ( 62, 45, 40, 60 % );
    surface-alpha: rgba ( 127, 99, 93, 78 % );
    foreground: #f6f7fb;
    muted: #b9c4d2;
    select: #997a73;
    select-alpha: rgba ( 153, 122, 115, 76 % );

    accent: #c18c80;
    accent-alpha: rgba ( 193, 140, 128, 84 % );
    border: #98817b;
    border-alpha: rgba ( 152, 129, 123, 55 % );
    pink: #f5c2e7;
    purple: #cba6f7;
    red: #f38ba8;
    orange: #fab387;
    yellow: #f9e2af;
    green: #a6e3a1;
    blue: @accent;
    gray: #45475a;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

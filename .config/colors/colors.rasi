* {
    background: #392925;
    surface: #7f655f;
    base: #483632;
    base-alt: #624c47;
    titlebar: #7f655f;
    titlebar-backdrop: #705852;
    popover: #705852;
    background-alpha: rgba ( 57, 41, 37, 60 % );
    surface-alpha: rgba ( 127, 101, 95, 78 % );
    foreground: #f6f7fb;
    muted: #b9c4d2;
    select: #9e817a;
    select-alpha: rgba ( 158, 129, 122, 76 % );

    accent: #c38f83;
    selected-fg: #11111b;
    accent-alpha: rgba ( 195, 143, 131, 84 % );
    border: #98827d;
    border-alpha: rgba ( 152, 130, 125, 55 % );
    pink: #dba6a7;
    purple: #bd8ea3;
    red: #f38ba8;
    orange: #d39a7a;
    yellow: #ddb39c;
    green: #a7ac8c;
    blue: @accent;
    gray: #544d59;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

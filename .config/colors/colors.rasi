* {
    background: #342b35;
    surface: #5e4f5d;
    base: #3e343f;
    base-alt: #4e414e;
    titlebar: #685363;
    titlebar-backdrop: #554754;
    popover: #554754;
    panel-bg: rgba ( 52, 43, 53, 62 % );
    panel-bg-hover: rgba ( 52, 43, 53, 78 % );
    overlay-bg: rgba ( 52, 43, 53, 28 % );
    item-bg: rgba ( 94, 79, 93, 18 % );
    item-bg-hover: rgba ( 142, 100, 122, 30 % );
    item-bg-active: rgba ( 142, 100, 122, 42 % );
    accent-soft: rgba ( 219, 129, 170, 22 % );
    accent-strong: rgba ( 219, 129, 170, 42 % );
    border-soft: rgba ( 160, 122, 142, 16 % );
    border-medium: rgba ( 160, 122, 142, 34 % );
    shadow-soft: rgba ( 52, 43, 53, 18 % );
    shadow-medium: rgba ( 52, 43, 53, 30 % );
    background-alpha: rgba ( 52, 43, 53, 62 % );
    surface-alpha: rgba ( 94, 79, 93, 18 % );
    foreground: #f6f7fb;
    muted: #aca9b0;
    select: #8e647a;
    select-alpha: rgba ( 142, 100, 122, 42 % );

    accent: #db81aa;
    selected-fg: #11111b;
    accent-alpha: rgba ( 219, 129, 170, 42 % );
    border: #a07a8e;
    border-alpha: rgba ( 160, 122, 142, 34 % );
    pink: #f1b8de;
    purple: #cda2eb;
    red: #ef8aa8;
    orange: #f6ad8a;
    yellow: #f7daaf;
    green: #acd4a2;
    blue: @accent;
    cyan: @muted;
    gray: #6d6e85;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

* {
    background: #152532;
    surface: #31495b;
    base: #1c2e3c;
    base-alt: #263b4b;
    titlebar: #315065;
    titlebar-backdrop: #2b4152;
    popover: #2b4152;
    panel-bg: rgba ( 21, 37, 50, 62 % );
    panel-bg-hover: rgba ( 21, 37, 50, 78 % );
    overlay-bg: rgba ( 21, 37, 50, 28 % );
    item-bg: rgba ( 49, 73, 91, 18 % );
    item-bg-hover: rgba ( 57, 113, 142, 30 % );
    item-bg-active: rgba ( 57, 113, 142, 42 % );
    accent-soft: rgba ( 52, 166, 220, 22 % );
    accent-strong: rgba ( 52, 166, 220, 42 % );
    border-soft: rgba ( 84, 134, 160, 16 % );
    border-medium: rgba ( 84, 134, 160, 34 % );
    shadow-soft: rgba ( 21, 37, 50, 18 % );
    shadow-medium: rgba ( 21, 37, 50, 30 % );
    background-alpha: rgba ( 21, 37, 50, 62 % );
    surface-alpha: rgba ( 49, 73, 91, 18 % );
    foreground: #f6f7fb;
    muted: #a1a7af;
    select: #39718e;
    select-alpha: rgba ( 57, 113, 142, 42 % );

    accent: #34a6dc;
    selected-fg: #11111b;
    accent-alpha: rgba ( 52, 166, 220, 42 % );
    border: #5486a0;
    border-alpha: rgba ( 84, 134, 160, 34 % );
    pink: #d8bee5;
    purple: #b4a6f3;
    red: #d68fb0;
    orange: #e2b18f;
    yellow: #e9ddb1;
    green: #98daa8;
    blue: @accent;
    cyan: @muted;
    gray: #5e677f;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

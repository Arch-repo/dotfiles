* {
    background: #281f33;
    surface: #635575;
    background-alpha: rgba ( 40, 31, 51, 60 % );
    surface-alpha: rgba ( 99, 85, 117, 78 % );
    foreground: #f6f7fb;
    muted: #b9c4d2;
    select: #7f6f93;
    select-alpha: rgba ( 127, 111, 147, 76 % );

    accent: #9579b6;
    accent-alpha: rgba ( 149, 121, 182, 84 % );
    border: #817590;
    border-alpha: rgba ( 129, 117, 144, 55 % );
    pink: #c59dc5;
    purple: #a383c7;
    red: #f38ba8;
    orange: #b3908b;
    yellow: #c6a7aa;
    green: #969e9f;
    blue: @accent;
    gray: #4b4761;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

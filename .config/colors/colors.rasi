* {
    background: #22385b;
    surface: #5a7db5;
    base: #2e476f;
    base-alt: #42608f;
    titlebar: #5a7db5;
    titlebar-backdrop: #4e6ea1;
    popover: #4e6ea1;
    background-alpha: rgba ( 34, 56, 91, 60 % );
    surface-alpha: rgba ( 90, 125, 181, 78 % );
    foreground: #f6f7fb;
    muted: #b9c4d2;
    select: #749cda;
    select-alpha: rgba ( 116, 156, 218, 76 % );

    accent: #80b1fe;
    selected-fg: #11111b;
    accent-alpha: rgba ( 128, 177, 254, 84 % );
    border: #7997c5;
    border-alpha: rgba ( 121, 151, 197, 55 % );
    pink: #bbb4f0;
    purple: #979ffa;
    red: #f38ba8;
    orange: #a6a9a1;
    yellow: #bcc4bf;
    green: #8fc0b8;
    blue: @accent;
    gray: #475577;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

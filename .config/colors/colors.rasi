* {
    background: #292839;
    surface: #606082;
    base: #353449;
    base-alt: #494863;
    titlebar: #606082;
    titlebar-backdrop: #545472;
    popover: #545472;
    panel-bg: rgba ( 41, 40, 57, 62 % );
    panel-bg-hover: rgba ( 41, 40, 57, 78 % );
    overlay-bg: rgba ( 41, 40, 57, 28 % );
    item-bg: rgba ( 96, 96, 130, 18 % );
    item-bg-hover: rgba ( 116, 120, 163, 30 % );
    item-bg-active: rgba ( 116, 120, 163, 42 % );
    accent-soft: rgba ( 113, 130, 191, 22 % );
    accent-strong: rgba ( 113, 130, 191, 42 % );
    border-soft: rgba ( 121, 123, 157, 16 % );
    border-medium: rgba ( 121, 123, 157, 34 % );
    shadow-soft: rgba ( 41, 40, 57, 18 % );
    shadow-medium: rgba ( 41, 40, 57, 30 % );
    background-alpha: rgba ( 41, 40, 57, 62 % );
    surface-alpha: rgba ( 96, 96, 130, 18 % );
    foreground: #f6f7fb;
    muted: #b9c4d2;
    select: #7478a3;
    select-alpha: rgba ( 116, 120, 163, 42 % );

    accent: #7182bf;
    selected-fg: #f6f7fb;
    accent-alpha: rgba ( 113, 130, 191, 42 % );
    border: #797b9d;
    border-alpha: rgba ( 121, 123, 157, 34 % );
    pink: #9586b7;
    purple: #7b7bb6;
    red: #bf7a97;
    orange: #a88a8b;
    yellow: #a89eb7;
    green: #8e9aac;
    blue: @accent;
    cyan: @muted;
    gray: #4e4d62;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

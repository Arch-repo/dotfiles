* {
    background: #342735;
    surface: #805a75;
    base: #453243;
    base-alt: #60455a;
    titlebar: #805a75;
    titlebar-backdrop: #6f4f67;
    popover: #6f4f67;
    panel-bg: rgba ( 52, 39, 53, 62 % );
    panel-bg-hover: rgba ( 52, 39, 53, 78 % );
    overlay-bg: rgba ( 52, 39, 53, 28 % );
    item-bg: rgba ( 128, 90, 117, 18 % );
    item-bg-hover: rgba ( 169, 106, 140, 30 % );
    item-bg-active: rgba ( 169, 106, 140, 42 % );
    accent-soft: rgba ( 226, 94, 139, 22 % );
    accent-strong: rgba ( 226, 94, 139, 42 % );
    border-soft: rgba ( 158, 114, 141, 16 % );
    border-medium: rgba ( 158, 114, 141, 34 % );
    shadow-soft: rgba ( 52, 39, 53, 18 % );
    shadow-medium: rgba ( 52, 39, 53, 30 % );
    background-alpha: rgba ( 52, 39, 53, 62 % );
    surface-alpha: rgba ( 128, 90, 117, 18 % );
    foreground: #f6f7fb;
    muted: #b9c4d2;
    select: #a96a8c;
    select-alpha: rgba ( 169, 106, 140, 42 % );

    accent: #e25e8b;
    selected-fg: #f6f7fb;
    accent-alpha: rgba ( 226, 94, 139, 42 % );
    border: #9e728d;
    border-alpha: rgba ( 158, 114, 141, 34 % );
    pink: #f0a9d2;
    purple: #cd95df;
    red: #ef7a9c;
    orange: #f6a182;
    yellow: #f6d2ab;
    green: #acc598;
    blue: @accent;
    cyan: @muted;
    gray: #6a6e85;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

* {
    background: #312d43;
    surface: #6e6594;
    base: #3e3955;
    base-alt: #544d72;
    titlebar: #6e6594;
    titlebar-backdrop: #615982;
    popover: #615982;
    panel-bg: rgba ( 49, 45, 67, 62 % );
    panel-bg-hover: rgba ( 49, 45, 67, 78 % );
    overlay-bg: rgba ( 49, 45, 67, 28 % );
    item-bg: rgba ( 110, 101, 148, 18 % );
    item-bg-hover: rgba ( 131, 120, 182, 30 % );
    item-bg-active: rgba ( 131, 120, 182, 42 % );
    accent-soft: rgba ( 128, 112, 209, 22 % );
    accent-strong: rgba ( 128, 112, 209, 42 % );
    border-soft: rgba ( 134, 125, 174, 16 % );
    border-medium: rgba ( 134, 125, 174, 34 % );
    shadow-soft: rgba ( 49, 45, 67, 18 % );
    shadow-medium: rgba ( 49, 45, 67, 30 % );
    background-alpha: rgba ( 49, 45, 67, 62 % );
    surface-alpha: rgba ( 110, 101, 148, 18 % );
    foreground: #f6f7fb;
    muted: #b9c4d2;
    select: #8378b6;
    select-alpha: rgba ( 131, 120, 182, 42 % );

    accent: #8070d1;
    selected-fg: #f6f7fb;
    accent-alpha: rgba ( 128, 112, 209, 42 % );
    border: #867dae;
    border-alpha: rgba ( 134, 125, 174, 34 % );
    pink: #9a82be;
    purple: #8373c4;
    red: #c17899;
    orange: #ab868d;
    yellow: #ab99ba;
    green: #9094b0;
    blue: @accent;
    cyan: @muted;
    gray: #525268;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

* {
    background: #211b33;
    surface: #584e74;
    base: #2d2641;
    base-alt: #413959;
    titlebar: #584e74;
    titlebar-backdrop: #4c4366;
    popover: #4c4366;
    background-alpha: rgba ( 33, 27, 51, 60 % );
    surface-alpha: rgba ( 88, 78, 116, 78 % );
    foreground: #f6f7fb;
    muted: #b9c4d2;
    select: #736892;
    select-alpha: rgba ( 115, 104, 146, 76 % );

    accent: #826fb8;
    selected-fg: #f6f7fb;
    accent-alpha: rgba ( 130, 111, 184, 84 % );
    border: #78708f;
    border-alpha: rgba ( 120, 112, 143, 55 % );
    pink: #bc99c6;
    purple: #997ec8;
    red: #f38ba8;
    orange: #a78c8b;
    yellow: #bda2ab;
    green: #90989f;
    blue: @accent;
    gray: #474560;

    active-background: @select;
    urgent-background: @red;
    urgent-foreground: @background;
    selected-background: @accent;
    selected-urgent-background: @urgent-background;
    selected-active-background: @active-background;
    bordercolor: @border;
}

/* @import "$HOME/.config/colors/colors.css" */
@import "../colors/colors.css";

* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 12px;
    font-weight: 600;
    background-color: transparent;
    border-radius: 0;
    min-height: 0;
}

tooltip {
    color: @foreground;
    background: alpha(@surface, 0.72);
    border: 1px solid alpha(@border, 0.28);
    border-radius: 8px;
    padding: 6px 8px;
}

#waybar {
    background: alpha(@background, 0.38);
    border-bottom: 1px solid alpha(@border, 0.14);
    border-radius: 0;
}

#workspaces {
    margin: 4px 7px;
}

#workspaces button {
    color: alpha(@foreground, 0.74);
    background: transparent;
    border: 1px solid transparent;
    margin: 0 2px;
    padding: 0 7px;
    min-width: 24px;
    min-height: 22px;
    border-radius: 6px;
}

#workspaces button:hover {
    transition: none;
    color: @foreground;
    background: alpha(@surface, 0.36);
    border-color: alpha(@border, 0.22);
}

#workspaces button.active {
    color: @foreground;
    background: alpha(@accent, 0.22);
    border-color: alpha(@accent, 0.48);
}

#workspaces button.urgent {
    color: @foreground;
    background: alpha(@red, 0.20);
    border-color: alpha(@red, 0.52);
}

#custom-screenshot,
#custom-notifications,
#custom-control,
#custom-power,
#network,
#bluetooth,
#battery,
#pulseaudio,
#clock {
    color: @foreground;
    margin: 4px 3px;
    padding: 0 7px;
    min-height: 22px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
}

#custom-screenshot:hover,
#custom-notifications:hover,
#custom-control:hover,
#custom-power:hover,
#network:hover,
#bluetooth:hover,
#battery:hover,
#pulseaudio:hover,
#clock:hover {
    background: alpha(@surface, 0.36);
    border-color: alpha(@border, 0.22);
}

#custom-screenshot {
    color: alpha(@foreground, 0.86);
}

#custom-screenshot:hover {
    color: @green;
    border-color: alpha(@green, 0.42);
}

#custom-notifications,
#custom-control {
    color: alpha(@foreground, 0.84);
    min-width: 18px;
    padding: 0 8px;
}

#custom-notifications:hover {
    color: @accent;
    border-color: alpha(@accent, 0.36);
}

#custom-control:hover {
    color: @yellow;
    border-color: alpha(@yellow, 0.36);
}

#network,
#bluetooth {
    color: alpha(@foreground, 0.82);
    min-width: 18px;
    padding: 0 8px;
}

#network.wifi,
#network.ethernet,
#bluetooth.connected {
    color: @accent;
}

#network.disconnected,
#bluetooth.disabled,
#bluetooth.off {
    color: alpha(@foreground, 0.46);
}

#network:hover,
#bluetooth:hover {
    color: @foreground;
}

#battery {
    color: alpha(@foreground, 0.78);
}

#pulseaudio {
    color: alpha(@foreground, 0.78);
}

#clock {
    color: @foreground;
    padding: 0 12px;
}

#custom-power {
    margin-right: 8px;
    color: alpha(@foreground, 0.86);
    padding: 0 10px;
    font-size: 14px;
}

#custom-power:hover {
    color: @red;
    background: alpha(@red, 0.08);
    border-color: alpha(@red, 0.34);
}

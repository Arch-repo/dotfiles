{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "height": 46,
  "margin-top": 7,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 7,
  "fixed-center": true,
  "reload_style_on_change": true,
  "on-sigusr2": "reload",

  "modules-left": [
    "custom/launcher",
    "group/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "group/center-deck"
  ],
  "modules-right": [
    "group/quick",
    "group/status",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "󰣇",
    "tooltip-format": "Applicazioni",
    "on-click": "$HOME/.local/bin/anto-menu apps",
    "on-click-right": "$HOME/.local/bin/anto-menu system"
  },

  "group/workspaces": {
    "orientation": "horizontal",
    "modules": [
      "custom/workspace-first",
      "custom/workspace-current",
      "custom/workspace-last"
    ]
  },

  "custom/workspace-first": {
    "exec": "$HOME/.local/libexec/anto426/workspace-triad stream first",
    "return-type": "json",
    "format": "{}",
    "restart-interval": 1,
    "hide-empty-text": true,
    "escape": true,
    "tooltip": true,
    "exec-on-event": false,
    "on-click": "$HOME/.local/libexec/anto426/workspace-triad activate first",
    "on-scroll-up": "$HOME/.local/libexec/anto426/workspace-triad cycle previous",
    "on-scroll-down": "$HOME/.local/libexec/anto426/workspace-triad cycle next"
  },

  "custom/workspace-current": {
    "exec": "$HOME/.local/libexec/anto426/workspace-triad stream current",
    "return-type": "json",
    "format": "{}",
    "restart-interval": 1,
    "hide-empty-text": true,
    "escape": true,
    "tooltip": true,
    "exec-on-event": false,
    "on-click": "$HOME/.local/libexec/anto426/workspace-triad activate current",
    "on-scroll-up": "$HOME/.local/libexec/anto426/workspace-triad cycle previous",
    "on-scroll-down": "$HOME/.local/libexec/anto426/workspace-triad cycle next"
  },

  "custom/workspace-last": {
    "exec": "$HOME/.local/libexec/anto426/workspace-triad stream last",
    "return-type": "json",
    "format": "{}",
    "restart-interval": 1,
    "hide-empty-text": true,
    "escape": true,
    "tooltip": true,
    "exec-on-event": false,
    "on-click": "$HOME/.local/libexec/anto426/workspace-triad activate last",
    "on-scroll-up": "$HOME/.local/libexec/anto426/workspace-triad cycle previous",
    "on-scroll-down": "$HOME/.local/libexec/anto426/workspace-triad cycle next"
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 30,
    "separate-outputs": true,
    "rewrite": {
      "": "",
      "Ghostty": "  Ghostty",
      "bash": "  Terminal",
      "zsh": "  Terminal",
      "(.*) — Mozilla Firefox": "󰈹  $1",
      "(.*) — Zen Browser": "󰈹  $1",
      "Zen Browser": "󰈹  Zen Browser",
      "(.*) - Google Chrome": "  $1",
      "(.*) - Antigravity": "󰘦  $1",
      "Antigravity": "󰘦  Antigravity",
      "(.*) - Codex": "󰘦  $1",
      "Codex": "󰘦  Codex",
      "(.*) - Visual Studio Code": "󰨞  $1",
      "(.*) - Code - OSS": "󰨞  $1",
      "Spotify Free": "  Spotify",
      "Spotify Premium": "  Spotify",
      "Spotify": "  Spotify",
      "(.*) - Discord": "󰙯  $1",
      "Discord": "󰙯  Discord",
      "(.*) - Obsidian(.*)": "󰠮  Obsidian",
      "Thunar": "󰉋  Thunar",
      "nemo": "󰉋  Nemo"
    }
  },

  "group/center-deck": {
    "orientation": "horizontal",
    "modules": [
      "custom/media-prev",
      "custom/media",
      "custom/media-next",
      "clock"
    ]
  },

  "custom/media-prev": {
    "format": "󰒮",
    "tooltip-format": "Traccia precedente",
    "on-click": "playerctl --player=playerctld previous"
  },

  "custom/media": {
    "exec": "$HOME/.local/libexec/anto426/media-marquee stream",
    "return-type": "json",
    "format": "{}",
    "max-length": 34,
    "restart-interval": 2,
    "tooltip": true,
    "on-click": "playerctl --player=playerctld play-pause",
    "on-click-right": "bash -lc '$HOME/.config/anto426/media_status.sh menu >/dev/null 2>&1'",
    "on-scroll-up": "playerctl --player=playerctld next",
    "on-scroll-down": "playerctl --player=playerctld previous"
  },

  "custom/media-next": {
    "format": "󰒭",
    "tooltip-format": "Traccia successiva",
    "on-click": "playerctl --player=playerctld next"
  },

  "clock": {
    "interval": 30,
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b  ·  %H:%M}",
    "tooltip-format": "{:%A %d %B %Y}",
    "on-click": "$HOME/.local/bin/anto-menu calendar"
  },

  "group/quick": {
    "orientation": "horizontal",
    "modules": [
      "custom/background-apps",
      "custom/screenshot",
      "custom/notifications",
      "custom/control"
    ]
  },

  "custom/background-apps": {
    "exec": "$HOME/.config/anto426/background_status.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "$HOME/.local/bin/anto-menu background",
    "on-click-right": "$HOME/.local/bin/anto-menu background"
  },

  "custom/screenshot": {
    "exec": "$HOME/.local/libexec/anto-menu/anto-menu-backend record waybar-json",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": true,
    "on-click": "$HOME/.local/bin/anto-menu capture",
    "on-click-right": "$HOME/.local/bin/anto-menu capture-area-now",
    "on-click-middle": "$HOME/.local/bin/anto-menu record"
  },

  "custom/notifications": {
    "exec-if": "command -v swaync-client",
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "restart-interval": 5,
    "tooltip": true,
    "escape": true,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "$HOME/.local/bin/anto-menu notifications"
  },

  "custom/control": {
    "format": "󰒓",
    "tooltip-format": "Controlli rapidi",
    "on-click": "$HOME/.local/bin/anto-menu system",
    "on-click-right": "$HOME/.local/bin/anto-menu hardware"
  },

  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth",
      "pulseaudio",
      "battery"
    ]
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-linked": "󰖪",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}\n{ifname} · {signalStrength}%",
    "tooltip-format-ethernet": "Ethernet\n{ifname}",
    "tooltip-format-disconnected": "Rete disconnessa",
    "on-click": "$HOME/.local/bin/anto-menu wifi",
    "on-click-right": "$HOME/.local/bin/anto-menu wifi"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "format-connected-battery": "󰂱",
    "tooltip-format": "{controller_alias}\n{status}",
    "tooltip-format-connected": "{controller_alias}\n{device_alias}",
    "tooltip-format-connected-battery": "{controller_alias}\n{device_alias} · {device_battery_percentage}%",
    "on-click": "$HOME/.local/bin/anto-menu bluetooth",
    "on-click-right": "$HOME/.local/bin/anto-menu bluetooth"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰝟 {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "Volume · {volume}%",
    "on-click": "$HOME/.local/bin/anto-menu audio"
  },

  "battery": {
    "states": {
      "good": 85,
      "warning": 30,
      "critical": 15
    },
    "format": "<span font_family=\"JetBrainsMono Nerd Font\" size=\"large\">{icon}</span> {capacity}%",
    "format-full": "<span font_family=\"JetBrainsMono Nerd Font\" size=\"large\">{icon}</span> {capacity}%",
    "format-plugged": "<span font_family=\"JetBrainsMono Nerd Font\" size=\"large\">󰂄</span> {capacity}%",
    "format-charging": "<span font_family=\"JetBrainsMono Nerd Font\" size=\"large\">󰂄</span> {capacity}%",
    "format-alt": "<span font_family=\"JetBrainsMono Nerd Font\" size=\"large\">{icon}</span> {time}",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Batteria · {capacity}%\n{time}",
    "on-click": "$HOME/.local/bin/anto-menu brightness"
  },

  "custom/power": {
    "format": "",
    "tooltip-format": "Sessione e alimentazione",
    "on-click": "$HOME/.local/bin/anto-menu power",
    "on-click-right": "hyprlock"
  }
}

/* =============================================================================
   ANTO426 ROFI CONTROL SURFACE
   Sleek, transparent, minimalist vertical list theme.
   ============================================================================= */

configuration {
    show-icons:     true;
    icon-theme:     "Anto426-Material";
    application-fallback-icon: "application-default-icon";
    scroll-method:  1;
    scrollbar:      false;
}

@import "~/.config/colors/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font SemiBold 11";
    background-color: transparent;
    text-color: @foreground;
}

#window {
    location:         center;
    anchor:           center;
    x-offset:         0px;
    y-offset:         0px;
    width:            420px;
    padding:          16px;
    border:           1px;
    border-color:     @border-medium;
    border-radius:    18px;
    background-color: @panel-bg;
}

#mainbox {
    spacing:          12px;
    background-color: transparent;
}

#inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          6px 12px;
    border:           0px 0px 1px 0px;
    border-color:     @border-soft;
    background-color: transparent;
}

#prompt {
    padding:          2px 0px;
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

#textbox-prompt-colon {
    enabled:          false;
}

#entry {
    background-color: transparent;
    text-color:       @foreground;
    placeholder:      "Search...";
    placeholder-color: @muted;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font Medium 10.5";
}

#message {
    enabled:          true;
    padding:          10px 12px;
    border:           1px;
    border-color:     @border-soft;
    border-radius:    10px;
    background-color: @item-bg;
}

#textbox {
    enabled:          true;
    markup:           true;
    background-color: transparent;
    text-color:       @foreground;
    font:             "JetBrainsMono Nerd Font Medium 10";
    line-spacing:     3px;
}

#listview {
    columns:          1;
    lines:            8;
    fixed-height:     false;
    border:           0px;
    spacing:          5px;
    padding:          0px;
    scrollbar:        false;
    background-color: transparent;
}

#element {
    orientation:      horizontal;
    border-radius:    10px;
    padding:          8px 12px;
    background-color: transparent;
    text-color:       @foreground;
}

#element.normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

#element.alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

#element.normal.active {
    background-color: transparent;
    text-color:       @accent;
}

#element.alternate.active {
    background-color: transparent;
    text-color:       @accent;
}

#element.selected.normal {
    background-color: @item-bg-hover;
    text-color:       @accent;
}

#element.selected.active {
    background-color: @item-bg-active;
    text-color:       @accent;
}

#element-icon {
    size:             28px;
    margin:           0px 12px 0px 0px;
    vertical-align:   0.5;
    background-color: transparent;
}

#element-text {
    expand:           true;
    background-color: transparent;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font Medium 11";
    horizontal-align: 0.0;
    vertical-align:   0.5;
}

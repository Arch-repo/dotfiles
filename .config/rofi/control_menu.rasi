/* =============================================================================
   ROFI DEDICATED CONTROL MENU THEME
   Style: Compact Glassmorphic Premium Widget Design
   ============================================================================= */

configuration {
    show-icons:     false;
    scroll-method:  1;
    scrollbar:      false;
}

@import "~/.config/colors/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font SemiBold 11.5";
    background-color: transparent;
    text-color: @foreground;
}

#window {
    location:         center;
    anchor:           center;
    x-offset:         0px;
    y-offset:         0px;
    background-color: @background-alpha;
    border:           2px;
    border-color:     @border-alpha;
    border-radius:    24px;
    padding:          24px;
    width:            430px;
}

#mainbox {
    spacing:          18px;
    background-color: transparent;
}

#message {
    border:           0px;
    border-radius:    16px;
    padding:          14px 18px;
    background-color: @surface-alpha;
}

#textbox {
    background-color: transparent;
    text-color:       @foreground;
    font:             "JetBrainsMono Nerd Font Medium 11";
    line-spacing:     5px;
}

#listview {
    columns:          1;
    lines:            10;
    fixed-height:     false;
    border:           0px;
    spacing:          8px;
    scrollbar:        false;
    background-color: transparent;
}

#element {
    border:           1px;
    border-color:     transparent;
    border-radius:    14px;
    padding:          12px 16px;
    background-color: transparent;
    text-color:       @foreground;
}

#element.normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

#element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

#element.normal.active {
    background-color: @active-background;
    text-color:       @foreground;
}

#element.alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

#element.alternate.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

#element.alternate.active {
    background-color: @active-background;
    text-color:       @foreground;
}

#element.selected.normal {
    background-color: @accent;
    text-color:       @selected-fg;
    border:           0px;
    border-radius:    14px;
}

#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-fg;
    border:           0px;
    border-radius:    14px;
}

#element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-fg;
    border:           0px;
    border-radius:    14px;
}

#element-icon {
    size:             24px;
    margin:           0px 10px 0px 0px;
    background-color: transparent;
}

#element-text {
    background-color: inherit;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font SemiBold 11.5";
}

#inputbar {
    spacing:          8px;
    padding:          12px 16px;
    border:           0px;
    border-radius:    14px;
    background-color: @surface-alpha;
}

#prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 12.5";
}

#entry {
    background-color: transparent;
    text-color:       @foreground;
    placeholder-color: #b9c4d2;
}

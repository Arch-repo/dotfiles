/* =============================================================================
   ANTO426 ROFI CONTROL SURFACE
   Compact glass theme shared by control menus, tools and utility dialogs.
   ============================================================================= */

configuration {
    show-icons:     true;
    scroll-method:  1;
    scrollbar:      false;
}

@import "~/.config/colors/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font SemiBold 11";
    background-color: transparent;
    text-color: @foreground;
}

#window {
    location:         center;
    anchor:           center;
    x-offset:         0px;
    y-offset:         0px;
    width:            500px;
    padding:          18px;
    border:           1px;
    border-color:     @border-medium;
    border-radius:    24px;
    background-color: @panel-bg;
}

#mainbox {
    spacing:          14px;
    background-color: transparent;
}

#inputbar {
    children:         [ prompt, entry ];
    spacing:          12px;
    padding:          8px 14px;
    border:           0px 0px 1px 0px;
    border-color:     @border-soft;
    border-radius:    0px;
    background-color: transparent;
}

#prompt {
    padding:          5px 0px;
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrainsMono Nerd Font Bold 11";
}

#textbox-prompt-colon {
    enabled:          false;
}

#entry {
    background-color: transparent;
    text-color:       @foreground;
    placeholder:      "Search...";
    placeholder-color: @muted;
    vertical-align:   0.5;
    font:             "JetBrainsMono Nerd Font Medium 10.5";
}

#message {
    enabled:          true;
    padding:          10px 12px;
    border:           0px;
    border-radius:    10px;
    background-color: @item-bg;
}

#textbox {
    enabled:          true;
    markup:           true;
    background-color: transparent;
    text-color:       @foreground;
    font:             "JetBrainsMono Nerd Font Medium 10";
    line-spacing:     4px;
}

#listview {
    columns:          1;
    lines:            10;
    fixed-height:     false;
    border:           0px;
    spacing:          7px;
    padding:          1px;
    scrollbar:        false;
    background-color: transparent;
}

#element {
    children:         [ element-icon, element-text ];
    orientation:      horizontal;
    border:           1px;
    border-color:     transparent;
    border-radius:    14px;
    padding:          10px 13px;
    background-color: transparent;
    text-color:       @foreground;
}

#element.normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

#element.alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

#element.normal.active {
    background-color: @item-bg-hover;
    text-color:       @foreground;
    border-color:     @border-medium;
}

#element.alternate.active {
    background-color: @item-bg-hover;
    text-color:       @foreground;
    border-color:     @border-medium;
}

#element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

#element.alternate.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

#element.selected.normal {
    background-color: @item-bg-active;
    text-color:       @foreground;
    border-color:     @accent-strong;
}

#element.selected.active {
    background-color: @accent-strong;
    text-color:       @foreground;
    border-color:     @accent-strong;
}

#element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @foreground;
    border-color:     @selected-urgent-background;
}

#element-icon {
    size:             25px;
    margin:           0px 11px 0px 0px;
    background-color: transparent;
}

#element-text {
    expand:           true;
    background-color: transparent;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font SemiBold 11";
    horizontal-align: 0.0;
    vertical-align:   0.5;
}

#scrollbar {
    width:            4px;
    border:           0px;
    handle-width:     4px;
    padding:          0px 0px 0px 4px;
    handle-color:     @accent-strong;
}

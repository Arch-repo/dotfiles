/* =============================================================================
   ROFI DEDICATED SETUP THEME
   Wider layout for guided configuration flows with long paths and URLs.
   ============================================================================= */

@import "~/.config/rofi/control_menu.rasi"

#window {
    width:            720px;
    padding:          20px;
    border-radius:    24px;
}

#mainbox {
    spacing:          14px;
}

#message {
    padding:          14px 16px;
    border-radius:    14px;
}

#textbox {
    font:             "JetBrainsMono Nerd Font Medium 10.5";
}

#listview {
    lines:            7;
    spacing:          7px;
}

#element {
    padding:          10px 13px;
}

#inputbar {
    padding:          10px 12px;
    spacing:          10px;
}

#prompt {
    font:             "JetBrainsMono Nerd Font Bold 11";
}

#entry {
    font:             "JetBrainsMono Nerd Font Medium 10.5";
}

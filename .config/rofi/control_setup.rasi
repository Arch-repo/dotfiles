/* =============================================================================
   ROFI DEDICATED SETUP THEME
   Wider layout for guided configuration flows with long paths and URLs.
   ============================================================================= */

@import "~/.config/rofi/control_menu.rasi"

#window {
    width:            720px;
    padding:          22px;
    border-radius:    24px;
}

#mainbox {
    spacing:          16px;
}

#message {
    padding:          16px 18px;
    border-radius:    16px;
}

#textbox {
    font:             "JetBrainsMono Nerd Font Medium 10.5";
}

#listview {
    lines:            7;
    spacing:          9px;
}

#element {
    padding:          11px 16px;
}

#inputbar {
    padding:          12px 16px;
    spacing:          10px;
}

#prompt {
    font:             "JetBrainsMono Nerd Font Bold 11";
}

#entry {
    font:             "JetBrainsMono Nerd Font Medium 10.5";
}

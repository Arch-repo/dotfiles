configuration {
    scroll-method: 1;
    scrollbar: false;
    show-icons: true;
    icon-theme: "WhiteSur-dark";
    application-fallback-icon: "application-default-icon";
    display-run: "Run";
    display-drun: "Apps";
    display-emoji: "Emoji";
    drun-display-format: "{name}";
    modi: "run,drun,emoji";
}

@import "~/.config/colors/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";
}

#window {
    location:         center;
    anchor:           center;
    x-offset:         0px;
    y-offset:         0px;
    background-color: @surface-alpha;
    border:           0;
    border-radius:    18;
    padding:          16;
    width:            720px;
}

#mainbox {
    spacing: 12px;
}

#listview {
    columns:      2;
    lines:        6;
    fixed-height: 0;
    border:       0px;
    spacing:      8px;
    padding:      2px;
}

#element {
    children:      [ element-icon, element-text ];
    orientation:   horizontal;
    border:        0;
    border-radius: 12px;
    padding:       10px 12px;
}

#element.normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

#element.alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

#element.selected.normal {
    background-color: @select-alpha;
    text-color:       @foreground;
}

#element-icon {
    size:             32px;
    margin:           0px 12px 0px 0px;
    background-color: transparent;
}

#element-text {
    expand:           true;
    horizontal-align: 0.0;
    vertical-align:   0.5;
    background-color: inherit;
    text-color:       inherit;
}

#scrollbar {
    width:        2px ;
    border:       0;
    handle-width: 8px ;
    padding:      0;
    handle-color: @select;
}

#inputbar {
    children:   [ prompt, textbox-prompt-colon, entry ];
    spacing:       8px;
    padding:       12px 14px;
    border:        0;
    border-radius: 14px;
    background-color: @background-alpha;
}

#prompt {
    spacing:    0;
    text-color: @accent;
}

#textbox-prompt-colon {
    expand:     false;
    str:        "/";
    margin:     0px 0.2em 0em 0em;
    text-color: @muted;
}

#entry {
    spacing:    0;
    text-color: @foreground;
    placeholder: "Cerca applicazioni";
    placeholder-color: @muted;
}

configuration {
    show-icons: false;
    scroll-method: 1;
    scrollbar: true;
}

@import "~/.config/colors/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font SemiBold 12";
    background-color: transparent;
    text-color: @foreground;
}

#window {
    location: center;
    anchor: center;
    background-color: @background-alpha;
    border: 2px;
    border-color: @border-alpha;
    border-radius: 24px;
    padding: 24px;
    width: 940px;
}

#mainbox {
    spacing: 16px;
    background-color: transparent;
}

#inputbar {
    spacing: 8px;
    padding: 12px 16px;
    border: 1px;
    border-color: @border;
    border-radius: 14px;
    background-color: @surface;
}

#prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 13";
}

#entry {
    text-color: @foreground;
    placeholder: "Cerca scorciatoie, sezioni o azioni...";
    placeholder-color: @muted;
}

#message {
    border: 1px;
    border-color: @border-alpha;
    border-radius: 16px;
    padding: 14px 16px;
    background-color: @surface-alpha;
}

#textbox {
    text-color: @foreground;
    font: "JetBrainsMono Nerd Font Medium 11";
}

#listview {
    columns: 1;
    lines: 22;
    fixed-height: true;
    spacing: 6px;
    padding: 2px;
    scrollbar: true;
    background-color: transparent;
}

#scrollbar {
    width: 4px;
    border: 0;
    handle-width: 8px;
    padding: 0;
    handle-color: @select;
}

#element {
    border: 1px;
    border-color: transparent;
    border-radius: 12px;
    padding: 8px 12px;
    background-color: transparent;
    text-color: @foreground;
}

#element.selected.normal {
    background-color: @accent;
    text-color: @selected-fg;
    border-color: @border;
}

#element-text {
    background-color: inherit;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font SemiBold 12";
}

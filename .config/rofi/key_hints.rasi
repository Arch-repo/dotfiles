configuration {
    show-icons: false;
    scroll-method: 1;
    scrollbar: true;
}

@import "~/.config/colors/colors.rasi"

* {
    font: "JetBrainsMono Nerd Font SemiBold 10";
    background-color: transparent;
    text-color: @foreground;
}

#window {
    location: center;
    anchor: center;
    background-color: @background-alpha;
    border: 2px;
    border-color: @border-alpha;
    border-radius: 16px;
    padding: 14px;
    width: 760px;
}

#mainbox {
    spacing: 10px;
    background-color: transparent;
}

#inputbar {
    spacing: 8px;
    padding: 9px 12px;
    border: 1px;
    border-color: @border;
    border-radius: 10px;
    background-color: @surface;
}

#prompt {
    text-color: @accent;
    font: "JetBrainsMono Nerd Font Bold 11";
}

#entry {
    text-color: @foreground;
    placeholder: "Cerca scorciatoie, sezioni o azioni...";
    placeholder-color: @muted;
}

#message {
    border: 1px;
    border-color: @border-alpha;
    border-radius: 10px;
    padding: 9px 12px;
    background-color: @surface-alpha;
}

#textbox {
    text-color: @foreground;
    font: "JetBrainsMono Nerd Font Medium 10";
}

#listview {
    columns: 1;
    lines: 16;
    fixed-height: true;
    spacing: 3px;
    padding: 2px;
    scrollbar: true;
    background-color: transparent;
}

#scrollbar {
    width: 4px;
    border: 0;
    handle-width: 8px;
    padding: 0;
    handle-color: @select;
}

#element {
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
    padding: 5px 8px;
    background-color: transparent;
    text-color: @foreground;
}

#element.selected.normal {
    background-color: @accent;
    text-color: @selected-fg;
    border-color: @border;
}

#element-text {
    background-color: inherit;
    text-color: inherit;
    font: "JetBrainsMono Nerd Font SemiBold 10";
}

/* =============================================================================
   ROFI KEY HINTS THEME
   Imports control_menu.rasi with overrides for wide grid list and scrollbars.
   ============================================================================= */

@import "~/.config/rofi/control_menu.rasi"

* {
    font: "JetBrainsMono Nerd Font SemiBold 10.5";
}

#window {
    width:            780px;
    padding:          20px;
}

#listview {
    lines:            15;
    scrollbar:        true;
    spacing:          5px;
}

#scrollbar {
    width:            4px;
    border:           0px;
    handle-width:     6px;
    padding:          0px 0px 0px 4px;
    handle-color:     @select;
}

#element {
    padding:          7px 12px;
}

#entry {
    placeholder:      "Search shortcuts, sections or actions...";
}

/* =============================================================================
   ROFI SLIDER PANEL (volume, mic, brightness)
   ============================================================================= */

@import "~/.config/rofi/control_menu.rasi"

#window {
    width: 360px;
    padding: 18px;
}

#mainbox {
    children: [message, control-slider-panel];
    spacing: 16px;
}

#message {
    border:           1px;
    border-color:     @border-alpha;
    border-radius:    16px;
    padding:          16px 14px 10px 14px;
    background-color: @surface-alpha;
    text-color:       @foreground;
}

control-slider-panel {
    orientation: horizontal;
    spacing: 0px;
    padding: 8px 8px 10px 8px;
    margin: 0px;
    background-color: transparent;
}

slider-volume,
slider-mic,
slider-brightness {
    min: 0;
    max: 100;
    step: 1;
    value: 50;
    length: 300px;
    orientation: horizontal;
    track-width: 8px;
    handle-width: 20px;
    padding: 12px 4px;
    track-color: @border-alpha;
    fill-color: @accent;
    handle-color: @foreground;
    track-rounded-corners: true;
    handle-rounded-corners: true;
}

#listview {
    lines: 0;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
    border: 0px;
}

#inputbar {
    enabled: false;
}

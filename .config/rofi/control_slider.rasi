/* =============================================================================
   ROFI SLIDER PANEL (volume, mic, brightness)
   ============================================================================= */

@import "~/.config/rofi/control_menu.rasi"

#window {
    width: 390px;
    padding: 18px;
}

#mainbox {
    children: [message, control-slider-panel];
    spacing: 14px;
}

#message {
    border:           1px;
    border-color:     @border-medium;
    border-radius:    14px;
    padding:          14px 14px 10px 14px;
    background-color: @item-bg;
    text-color:       @foreground;
}

control-slider-panel {
    children: [ slider-volume, slider-mic, slider-brightness, slider-fan ];
    orientation: vertical;
    spacing: 10px;
    padding: 8px 6px 10px 6px;
    margin: 0px;
    background-color: transparent;
}

slider-volume,
slider-mic,
slider-brightness,
slider-fan {
    min: 0;
    max: 100;
    step: 1;
    value: 50;
    length: 332px;
    orientation: horizontal;
    track-width: 8px;
    handle-width: 18px;
    padding: 12px 4px;
    track-color: @border-medium;
    fill-color: @accent;
    handle-color: @foreground;
    track-rounded-corners: true;
    handle-rounded-corners: true;
}

#listview {
    lines: 0;
    spacing: 0px;
    padding: 0px;
    margin: 0px;
    border: 0px;
}

#inputbar {
    enabled: false;
}

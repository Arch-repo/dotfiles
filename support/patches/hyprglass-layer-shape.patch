+// External shell clients have multiple independent panes in one surface.
+// Follow their GPU alpha silhouette rather than refracting the enclosing
+// rectangular layer. Eight fixed samples bound cost; no CPU readback.
+float layerCoverage(vec2 uv) {
+    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return 0.0;
+    vec2 coord = uv * maskUVScale + maskUVOffset;
+    return step(maskAlphaThreshold, texture(maskTex, coord).a);
+}
+vec3 layerEdgeField(vec2 uv, float widthPx) {
+    const vec2 directions[8] = vec2[8](vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1),
+        vec2(.707,.707),vec2(-.707,.707),vec2(.707,-.707),vec2(-.707,-.707));
+    vec2 inward = vec2(0.0);
+    float missing = 0.0;
+    for (int i=0; i<8; ++i) {
+        float outside = 1.0 - layerCoverage(uv + directions[i] * widthPx * invFullSize);
+        inward -= directions[i] * outside;
+        missing += outside;
+    }
+    float magnitude = length(inward);
+    return vec3(magnitude > .001 ? inward / magnitude : vec2(0.0), clamp(missing / 4.0, 0.0, 1.0));
+}
